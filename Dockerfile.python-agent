FROM eclipse-temurin:17-jdk AS bridge
WORKDIR /bridge
COPY java-bridge/src/com/mina/bridge/MinaJavaBridge.java ./MinaJavaBridge.java
RUN mkdir -p classes && javac -encoding UTF-8 -d classes MinaJavaBridge.java

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MINA_JAVA_BRIDGE_HOME=/opt/mina/java-bridge/build \
    MINA_DRIVER_HOME=/opt/mina/drivers \
    MINA_DATA_DIR=/var/lib/mina
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless libodbc2 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /tmp/backend-requirements.txt
ARG MINA_INSTALL_DB2=false
RUN if [ "$MINA_INSTALL_DB2" != true ]; then \
        sed -i '/^[[:space:]]*ibm-db[<=>!~]/d' /tmp/backend-requirements.txt; \
    fi \
    && pip install --no-cache-dir -r /tmp/backend-requirements.txt && pip check
COPY --from=bridge /bridge/classes /opt/mina/java-bridge/build/classes
COPY backend/app /opt/mina-runtime/app
COPY backend/run_container.py backend/run_deployment.py /opt/mina-runtime/
RUN useradd --uid 10001 --create-home mina \
    && mkdir -p /opt/mina/drivers /var/lib/mina/agent \
    && chown -R mina:mina /var/lib/mina
USER 10001
WORKDIR /var/lib/mina/agent

FROM runtime AS agent
USER root
ENV PYTHONPATH=/opt/agent
COPY administrator/requirements-agent.txt /tmp/agent-requirements.txt
RUN pip install --no-cache-dir -r /tmp/agent-requirements.txt && pip check
COPY administrator/agent /opt/agent/administrator/agent
USER 10001
CMD ["python", "-m", "administrator.agent.main"]
