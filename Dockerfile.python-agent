FROM eclipse-temurin:17-jdk AS bridge
WORKDIR /bridge
COPY java-bridge/src/com/mina/bridge/MinaJavaBridge.java ./MinaJavaBridge.java
RUN mkdir -p classes && javac -encoding UTF-8 -d classes MinaJavaBridge.java

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/agent \
    MINA_JAVA_BRIDGE_HOME=/opt/mina/java-bridge/build \
    MINA_DRIVER_HOME=/opt/mina/drivers
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY administrator/requirements-agent.txt /tmp/agent-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt -r /tmp/agent-requirements.txt
COPY --from=bridge /bridge/classes /opt/mina/java-bridge/build/classes
COPY administrator/agent /opt/agent/administrator/agent
RUN useradd --uid 10001 --create-home mina \
    && mkdir -p /opt/mina/drivers /var/lib/mina/agent \
    && chown -R mina:mina /var/lib/mina/agent
USER 10001
WORKDIR /var/lib/mina/agent
CMD ["python", "-m", "administrator.agent.main"]
