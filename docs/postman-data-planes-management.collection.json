{
  "info":{"name":"Integration Fabric - Data Planes Management","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://127.0.0.1:9080"},{"key":"adminKey","value":""},{"key":"dataPlaneId","value":"customer-data-delivery-plane"}],
