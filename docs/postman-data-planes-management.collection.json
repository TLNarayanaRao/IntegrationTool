    {"name":"Send heartbeat","request":{"method":"POST","header":[{"key":"X-Admin-Key","value":"{{adminKey}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"agentVersion\":\"1.0.0\",\"namespaces\":[\"customer-data-delivery\"],\"availableCapacity\":20}"},"url":"{{baseUrl}}/api/data-planes/{{dataPlaneId}}/heartbeat"}},
