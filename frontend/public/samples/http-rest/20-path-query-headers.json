{
  "id": "mina-example-20-path-query-headers",
  "name": "Path Query Headers",
  "description": "Local learning sample. Demo credentials only; see the accompanying README.",
  "resources": [
    {
      "id": "client",
      "name": "HTTP client connection",
      "type": "http",
      "config": {
        "connectorMode": "client",
        "baseUrl": "http://localhost:9002",
        "authentication": "None",
        "verifyTls": true,
        "connectionTimeoutMs": 5000,
        "socketTimeoutMs": 10000,
        "activityTimeoutSeconds": 30
      }
    }
  ],
  "tasks": [
    {
      "id": "Main",
      "name": "Main",
      "kind": "starter",
      "activities": [
        {
          "id": "Start",
          "name": "Start",
          "type": "start",
          "position": {
            "x": 150,
            "y": 160
          },
          "config": {}
        },
        {
          "id": "Call",
          "name": "Call",
          "type": "rest",
          "position": {
            "x": 450,
            "y": 160
          },
          "config": {
            "resourceId": "client",
            "operation": "invoke",
            "requestModel": "tree",
            "responseMode": "structured",
            "inputMappings": {
              "RestInputRequest.Config.requestURI": "\"/orders/{id}\"",
              "RestInputRequest.Config.Method": "\"GET\"",
              "RestInputRequest.Headers.accept": "\"application/json\"",
              "RestInputRequest.Config.URIParameters": "{\"id\": \"42\"}",
              "RestInputRequest.Config.QueryParameters": "{\"detail\": true}",
              "RestInputRequest.Headers.DynamicHeaders": "[{\"name\": \"X-Correlation-ID\", \"value\": \"mina-sample-001\"}, {\"name\": \"X-Channel\", \"value\": \"studio\"}]"
            }
          }
        },
        {
          "id": "End",
          "name": "End",
          "type": "end",
          "position": {
            "x": 750,
            "y": 160
          },
          "config": {}
        }
      ],
      "transitions": [
        {
          "id": "edge-0",
          "source": "Start",
          "target": "Call",
          "type": "success"
        },
        {
          "id": "edge-1",
          "source": "Call",
          "target": "End",
          "type": "success"
        }
      ]
    }
  ],
  "active_task_id": "Main",
  "active_environment": "local",
  "properties": {
    "local": [
      {
        "key": "demo.directory",
        "value": "",
        "data_type": "string"
      },
      {
        "key": "demo.username",
        "value": "mina-demo",
        "data_type": "string"
      },
      {
        "key": "demo.password",
        "value": "mina-demo-password",
        "data_type": "password"
      },
      {
        "key": "demo.clientId",
        "value": "mina-demo-client",
        "data_type": "string"
      },
      {
        "key": "demo.clientSecret",
        "value": "mina-demo-client-secret",
        "data_type": "password"
      },
      {
        "key": "demo.hmacSecret",
        "value": "mina-demo-hmac-secret-change-before-real-use",
        "data_type": "password"
      },
      {
        "key": "demo.jwtSecret",
        "value": "mina-demo-jwt-secret-at-least-32-characters",
        "data_type": "password"
      }
    ]
  }
