{
  "id": "mina-example-03-host-generic-http",
  "name": "Host a plain HTTP listener",
  "description": "Local learning sample. Demo credentials only; see the accompanying README.",
  "resources": [
    {
      "id": "api-03-host-generic-http-http",
      "type": "http",
      "name": "Host a plain HTTP listener \u00b7 API server",
      "config": {
        "connectorMode": "server",
        "host": "127.0.0.1",
        "port": 9003,
        "minimumQtpThreads": 1,
        "maximumQtpThreads": 8,
        "authentication": "None",
        "apiDocsEnabled": true,
        "apiDocsAccess": "authenticated"
      }
    }
  ],
  "tasks": [
    {
      "id": "api-03-host-generic-http-1",
      "name": "GET /hello",
      "kind": "starter",
      "description": "MINA API Blueprint: Host a plain HTTP listener. Declared example response for testing; replace with business logic.",
      "groups": [],
      "activities": [
        {
          "id": "Receive",
          "name": "HTTP-Listener",
          "type": "http_listener",
          "position": {
            "x": 150,
            "y": 160
          },
          "config": {
            "operation": "listen",
            "resourceId": "api-03-host-generic-http-http",
            "path": "/hello",
            "methods": "GET"
          }
        },
        {
          "id": "Reply",
          "name": "HTTP-Response",
          "type": "http_response",
          "position": {
            "x": 450,
            "y": 160
          },
          "config": {
            "operation": "response",
            "statusCode": 200,
            "contentType": "application/json",
            "inputMappings": {
              "body": "{\"message\": \"Hello from MINA\"}"
            }
          }
        },
        {
          "id": "End",
          "name": "End",
          "type": "end",
          "position": {
            "x": 750,
            "y": 160
          },
          "config": {}
        }
      ],
      "transitions": [
        {
          "id": "receive-reply",
          "source": "Receive",
          "target": "Reply",
          "type": "success"
        },
        {
          "id": "reply-end",
          "source": "Reply",
          "target": "End",
          "type": "success"
        }
      ]
    }
  ],
  "active_task_id": "api-03-host-generic-http-1",
  "active_environment": "local",
  "properties": {
    "local": [
      {
        "key": "demo.directory",
        "value": "",
        "data_type": "string"
      },
      {
        "key": "demo.username",
        "value": "mina-demo",
        "data_type": "string"
      },
      {
        "key": "demo.password",
        "value": "mina-demo-password",
        "data_type": "password"
      },
      {
        "key": "demo.clientId",
        "value": "mina-demo-client",
        "data_type": "string"
      },
      {
        "key": "demo.clientSecret",
        "value": "mina-demo-client-secret",
        "data_type": "password"
      },
      {
        "key": "demo.hmacSecret",
        "value": "mina-demo-hmac-secret-change-before-real-use",
        "data_type": "password"
      },
      {
        "key": "demo.jwtSecret",
        "value": "mina-demo-jwt-secret-at-least-32-characters",
        "data_type": "password"
      }
    ]
  }
}