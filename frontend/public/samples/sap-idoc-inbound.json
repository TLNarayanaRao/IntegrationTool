{
  "id":"sample-sap-idoc-inbound","name":"Sample - SAP IDoc Inbound Mediation","description":"Configure the SAP ECC connection and retrieve ORDERS05 metadata before running.","active_environment":"local","active_task_id":"main",
  "resources":[{"id":"sap-ecc","type":"sap","name":"SAP ECC","config":{"applicationServer":"${properties.connections.sap.applicationServer}","systemNumber":"${properties.connections.sap.systemNumber}","client":"${properties.connections.sap.client}","username":"${properties.connections.sap.username}","password":"${properties.connections.sap.password}","language":"EN"}}],
  "tasks":[{"id":"main","name":"Receive SAP Order IDoc","kind":"starter","activities":[
    {"id":"listen","type":"sap","name":"Listen for ORDERS05","position":{"x":45,"y":160},"config":{"operation":"idoc_listener","resourceId":"sap-ecc","idocType":"ORDERS05","programId":"${properties.connections.sap.programId}","gatewayHost":"${properties.connections.sap.gatewayHost}","gatewayService":"${properties.connections.sap.gatewayService}"}},
    {"id":"parse","type":"sap","name":"Parse ORDERS05","position":{"x":280,"y":160},"config":{"operation":"idoc_parser","resourceId":"sap-ecc","idocType":"ORDERS05","inputMappings":{"idoc":"${activities.listen.output.payload}"}}},
    {"id":"map","type":"mapper","name":"Map Canonical Order","position":{"x":510,"y":160},"config":{"targetSchema":{"type":"object","properties":{"documentNumber":{"type":"string"},"messageType":{"type":"string"},"payload":{"type":"object"}}},"mappings":[{"source":"${activities.parse.output.SAPIDoc.DOCNUM}","target":"documentNumber","targetType":"string","functions":[],"enabled":true},{"constant":"ORDERS","target":"messageType","targetType":"string","functions":[],"enabled":true},{"source":"${activities.parse.output.payload}","target":"payload","targetType":"object","functions":[],"enabled":true}]}},
    {"id":"end","type":"end","name":"End","position":{"x":750,"y":160},"config":{"inputMappings":{"order":"${activities.map.output}"}}}
  ],"transitions":[{"id":"e1","source":"listen","target":"parse","type":"success"},{"id":"e2","source":"parse","target":"map","type":"success"},{"id":"e3","source":"map","target":"end","type":"success"}]}]
}
