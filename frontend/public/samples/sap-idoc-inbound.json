{
  "id":"sample-sap-idoc-inbound","name":"Sample - ARTMAS05 IDoc to EMS","description":"Configure SAP and EMS connections, retrieve ARTMAS05 metadata on the SAP connection, then run the listener continuously.","active_environment":"local","active_task_id":"main",
  "resources":[
    {"id":"sap-ecc","type":"sap","name":"SAP ECC","config":{"applicationServerHost":"${properties.connections.sap.applicationServerHost}","systemNumber":"${properties.connections.sap.systemNumber}","client":"${properties.connections.sap.client}","username":"${properties.connections.sap.username}","password":"${properties.connections.sap.password}","language":"EN","programId":"${properties.connections.sap.programId}","gatewayHost":"${properties.connections.sap.gatewayHost}","gatewayService":"${properties.connections.sap.gatewayService}","release":"${properties.connections.sap.release}"}},
    {"id":"ems-connection","type":"ems","name":"TIBCO EMS","config":{"serverUrl":"${properties.connections.ems.serverUrl}","username":"${properties.connections.ems.username}","password":"${properties.connections.ems.password}","connectionFactoryType":"Direct"}}
  ],
  "tasks":[{"id":"main","name":"Receive ARTMAS05 and Publish JSON","kind":"starter","activities":[
    {"id":"listen","type":"sap","name":"ARTMAS05 IDoc Listener","position":{"x":35,"y":160},"config":{"operation":"idoc_listener","resourceId":"sap-ecc","idocType":"ARTMAS05","programId":"${properties.connections.sap.programId}","gatewayHost":"${properties.connections.sap.gatewayHost}","gatewayService":"${properties.connections.sap.gatewayService}","invocationProtocol":"tRFC"}},
    {"id":"log-xml","type":"log","name":"Log ARTMAS05 XML","position":{"x":265,"y":160},"config":{"level":"INFO","message":"Inbound ARTMAS05 IDoc XML","payloadText":"${activities.listen.output.payload}","includePayload":true}},
    {"id":"parse","type":"sap","name":"Parse ARTMAS05 IDoc","position":{"x":500,"y":160},"config":{"operation":"idoc_parser","resourceId":"sap-ecc","idocType":"ARTMAS05","idocOutputMode":"JSON","inputMappings":{"SAPIDoc":"${activities.listen.output.controlRecord}","IDoc":"${activities.listen.output.payload}"}}},
    {"id":"log-json","type":"log","name":"Log ARTMAS05 JSON","position":{"x":735,"y":160},"config":{"level":"INFO","message":"Parsed ARTMAS05 IDoc JSON","payloadText":"${activities.parse.output.SAPIDoc}","includePayload":true}},
    {"id":"send","type":"ems","name":"Send ARTMAS05 JSON to EMS","position":{"x":970,"y":160},"config":{"operation":"queue_sender","resourceId":"ems-connection","queue":"${properties.messaging.artmasQueue}","messageType":"Text","inputMappings":{"message":"${activities.parse.output.SAPIDoc}"}}},
    {"id":"end","type":"end","name":"End","position":{"x":1205,"y":160},"config":{"inputMappings":{"result":"${activities.send.output}"}}}
  ],"transitions":[{"id":"e1","source":"listen","target":"log-xml","type":"success"},{"id":"e2","source":"log-xml","target":"parse","type":"success"},{"id":"e3","source":"parse","target":"log-json","type":"success"},{"id":"e4","source":"log-json","target":"send","type":"success"},{"id":"e5","source":"send","target":"end","type":"success"}]}]
}
