{
  "id": "postgresql-crud",
  "name": "PostgreSQL CRUD",
  "description": "Run postgresql-setup.sql, set the local JDBC properties, then Debug. Shows typed JSONB and decimal binds, atomic upsert, guarded update and delete.",
  "active_environment": "local",
  "active_task_id": "main",
  "resources": [
    {
      "id": "postgres",
      "type": "jdbc",
      "name": "PostgreSQL-MINA-Demo",
      "config": {
        "driver": "postgresql",
        "connectionMode": "python",
        "schema": "mina_demo",
        "url": "${properties.connections.jdbc.url}",
        "username": "${properties.connections.jdbc.username}",
        "password": "${properties.connections.jdbc.password}"
      }
    }
  ],
  "properties": {
    "local": [
      {
        "key": "connections.jdbc.url",
        "value": "postgresql://localhost:5432/postgres",
        "data_type": "string"
      },
      {
        "key": "connections.jdbc.username",
        "value": "postgres",
        "data_type": "string"
      },
      {
        "key": "connections.jdbc.password",
        "value": "",
        "data_type": "password"
      }
    ]
  },
  "tasks": [
    {
      "id": "main",
      "name": "PostgreSQL CRUD",
      "kind": "subtask",
      "activities": [
        {
          "id": "n0",
          "name": "Start",
          "type": "start",
          "position": {
            "x": 80,
            "y": 150
          },
          "config": {}
        },
        {
          "id": "n1",
          "name": "Upsert",
          "type": "jdbc",
          "position": {
            "x": 290,
            "y": 150
          },
          "config": {
            "resourceId": "postgres",
            "operation": "insert",
            "sql": "INSERT INTO orders(id, amount, details) VALUES (:id, :amount, :details) ON CONFLICT (id) DO UPDATE SET amount=EXCLUDED.amount, details=EXCLUDED.details, version=1",
            "preparedParameters": [
              {
                "name": "id",
                "type": "integer"
              },
              {
                "name": "amount",
                "type": "decimal"
              },
              {
                "name": "details",
                "type": "jsonb"
              }
            ],
            "inputMappings": {
              "parameters.id": "99001",
              "parameters.amount": "12.345678",
              "parameters.details": "{\"source\":\"mina\"}"
            }
          }
        },
        {
          "id": "n2",
          "name": "Guarded-Update",
          "type": "jdbc",
          "position": {
            "x": 500,
            "y": 150
          },
          "config": {
            "resourceId": "postgres",
            "operation": "update",
            "sql": "UPDATE orders SET amount=:amount, version=version+1 WHERE id=:id AND version=:version",
            "preparedParameters": [
              {
                "name": "id",
                "type": "integer"
              },
              {
                "name": "version",
                "type": "integer"
              },
              {
                "name": "amount",
                "type": "decimal"
              }
            ],
            "inputMappings": {
              "parameters.id": "99001",
              "parameters.version": "1",
              "parameters.amount": "23.456789"
            }
          }
        },
        {
          "id": "n3",
          "name": "Read",
          "type": "jdbc",
          "position": {
            "x": 710,
            "y": 150
          },
          "config": {
            "resourceId": "postgres",
            "operation": "query",
            "sql": "SELECT id, amount::text AS amount, details, version FROM orders WHERE id=:id AND details ? 'source'",
            "preparedParameters": [
              {
                "name": "id",
                "type": "integer"
              }
            ],
            "inputMappings": {
              "parameters.id": "99001"
            }
          }
        },
        {
          "id": "n4",
          "name": "Delete",
          "type": "jdbc",
          "position": {
            "x": 920,
            "y": 150
          },
          "config": {
            "resourceId": "postgres",
            "operation": "delete",
            "sql": "DELETE FROM orders WHERE id=:id",
            "preparedParameters": [
              {
                "name": "id",
                "type": "integer"
              }
            ],
            "inputMappings": {
              "parameters.id": "99001"
            }
          }
        },
        {
          "id": "n5",
          "name": "End",
          "type": "end",
          "position": {
            "x": 1130,
            "y": 150
          },
          "config": {
            "inputMappings": {
              "result": "${last}"
            }
          }
        }
      ],
      "transitions": [
        {
          "id": "t0",
          "source": "n0",
          "target": "n1",
          "type": "success"
        },
        {
          "id": "t1",
          "source": "n1",
          "target": "n2",
          "type": "success"
        },
        {
          "id": "t2",
          "source": "n2",
          "target": "n3",
          "type": "success"
        },
        {
          "id": "t3",
          "source": "n3",
          "target": "n4",
          "type": "success"
        },
        {
          "id": "t4",
          "source": "n4",
          "target": "n5",
          "type": "success"
        }
      ]
    }
  ]
}
