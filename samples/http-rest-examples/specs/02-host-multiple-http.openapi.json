{
  "openapi": "3.0.3",
  "info": {
    "title": "MINA sample API",
    "version": "1.0.0"
  },
  "paths": {
    "/hello": {
      "get": {
        "operationId": "hello",
        "summary": "Read a sample greeting",
        "responses": {
          "200": {
            "description": "Greeting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Hello from MINA"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Read order using path and optional query values",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "42"
          },
          {
            "name": "detail",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "example": true
          }
        ],
        "responses": {
          "200": {
            "description": "Order example",
            "content": {
              "application/json": {
                "example": {
                  "id": "42",
                  "status": "accepted"
                }
              }
            }
          }
        }
      }
    },
    "/echo": {
      "post": {
        "operationId": "echo",
        "summary": "Validate and echo a JSON body",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "example": {
                "name": "Sample item",
                "quantity": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "example": {
                  "name": "Sample item",
                  "quantity": 2
                }
              }
            }
          }
        }
      }
    }
  }
}