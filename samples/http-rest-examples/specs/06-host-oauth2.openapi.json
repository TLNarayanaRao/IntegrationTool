{
  "openapi": "3.0.3",
  "info": {
    "title": "MINA sample API",
    "version": "1.0.0"
  },
  "paths": {
    "/hello": {
      "get": {
        "operationId": "hello",
        "summary": "Read a sample greeting",
        "responses": {
          "200": {
            "description": "Greeting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Hello from MINA"
                }
              }
            }
          }
        }
      }
    }
  }
}