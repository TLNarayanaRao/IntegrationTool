#!/usr/bin/env bash
set -euo pipefail
MINA_ADMIN_HOME="${MINA_ADMIN_HOME:-/opt/mina/control-plane}"
PID_DIR="${MINA_ADMIN_PID_DIR:-/opt/mina/run}"
LOG_DIR="${MINA_ADMIN_LOG_DIR:-/opt/mina/logs/control-plane}"
EXECUTABLE="$MINA_ADMIN_HOME/MinaAdministrator"
PID_FILE="$PID_DIR/minaadmin.pid"
mkdir -p "$PID_DIR" "$LOG_DIR"
case "${1:-status}" in
  start)
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then echo "MINA Administrator is already running"; exit 0; fi
    nohup "$EXECUTABLE" >>"$LOG_DIR/administrator.log" 2>&1 & echo $! >"$PID_FILE"
    echo "MINA Administrator started with PID $(cat "$PID_FILE")"
    ;;
  stop)
    [[ -f "$PID_FILE" ]] || { echo "MINA Administrator is not running"; exit 0; }
    kill "$(cat "$PID_FILE")"; rm -f "$PID_FILE"; echo "MINA Administrator stopped"
    ;;
  status)
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then echo "RUNNING PID $(cat "$PID_FILE")"; else echo "STOPPED"; fi
    ;;
  run) exec "$EXECUTABLE" ;;
  *) echo "Usage: minaadmin {start|stop|status|run}"; exit 2 ;;
esac
