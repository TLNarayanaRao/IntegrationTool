{
  "id":"sample-scheduler-logging","name":"Sample - Scheduled Integration","description":"Runnable scheduler and structured logging example.","active_environment":"local","active_task_id":"main",
  "tasks":[{"id":"main","name":"Scheduled Health Check","kind":"starter","activities":[
