    {"id":"end","type":"end","name":"End","position":{"x":550,"y":160},"config":{"inputMappings":{"trigger":"${activities.schedule.output}"}}}
  ],"transitions":[{"id":"e1","source":"schedule","target":"log","type":"success"},{"id":"e2","source":"log","target":"end","type":"success"}]}]
}
